# Copia este archivo como .env y agrega credenciales solo si usaras esos proveedores.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama normalmente no requiere clave; el servicio debe estar ejecutandose localmente.
OLLAMA_BASE_URL=http://localhost:11434

# Estos identificadores son ejemplos editables, no garantias de disponibilidad permanente.
OLLAMA_MODEL=llama3.2
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# LangSmith es opcional y queda desactivado por defecto.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-engineering-labs